<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <!-- ═══════════════════════════════════════════════════════════════════════
         Changeset 2 — Create departments table
         id     : UUID PK (gen_random_uuid())
         name   : VARCHAR(100) UNIQUE NOT NULL
         ═══════════════════════════════════════════════════════════════════════ -->
    <changeSet id="202410052000-create-departments-table" author="system">
        <createTable tableName="departments">
            <column name="id" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints nullable="false" primaryKey="true" primaryKeyName="departments_pkey"/>
            </column>
            <column name="name" type="VARCHAR(100)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uk_departments_name"/>
            </column>
            <column name="created_on" type="TIMESTAMP(6)" defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>
            <column name="updated_on" type="TIMESTAMP(6)" defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex tableName="departments" indexName="idx_departments_name">
            <column name="name"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
