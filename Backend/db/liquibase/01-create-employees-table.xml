<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <!-- ═══════════════════════════════════════════════════════════════════════
         Changeset 1 — Create employees table with UUID foreign keys
         ═══════════════════════════════════════════════════════════════════════ -->
    <changeSet id="202410051000-create-employees-table" author="system">
        <createTable tableName="employees">
            <column name="id" type="UUID">
                <constraints nullable="false" primaryKey="true" primaryKeyName="employees_pkey"/>
            </column>
            <column name="org_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(150)">
                <constraints nullable="false"/>
            </column>
            <column name="email" type="VARCHAR(255)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uk_employees_email"/>
            </column>
            <column name="phone" type="VARCHAR(20)">
                <constraints nullable="true" unique="true" uniqueConstraintName="uk_employees_phone"/>
            </column>
            <column name="department_id" type="UUID">
                <constraints nullable="true" foreignKeyName="fk_employees_department" references="departments(id)"/>
            </column>
            <column name="designation_id" type="UUID">
                <constraints nullable="true" foreignKeyName="fk_employees_designation" references="designations(id)"/>
            </column>
            <column name="metadata" type="JSONB">
                <constraints nullable="true"/>
            </column>
            <column name="created_on" type="TIMESTAMP(6)">
                <constraints nullable="false"/>
            </column>
            <column name="updated_on" type="TIMESTAMP(6)">
                <constraints nullable="false"/>
            </column>
            <column name="is_active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="UUID">
                <constraints nullable="true"/>
            </column>
            <column name="updated_by" type="UUID">
                <constraints nullable="true"/>
            </column>
        </createTable>
        <createIndex tableName="employees" indexName="idx_employees_org_id">
            <column name="org_id"/>
        </createIndex>
        <createIndex tableName="employees" indexName="idx_employees_department_id">
            <column name="department_id"/>
        </createIndex>
        <createIndex tableName="employees" indexName="idx_employees_designation_id">
            <column name="designation_id"/>
        </createIndex>
        <sql dbms="postgresql">
            CREATE INDEX idx_employees_metadata_gin ON employees USING GIN (metadata jsonb_path_ops);
        </sql>
    </changeSet>

</databaseChangeLog>
